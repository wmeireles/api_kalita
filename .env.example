# Configurações do Servidor
NODE_ENV=development
PORT=3000

# Configurações de Segurança
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters

# Configurações de CORS
PUBLIC_DOMAIN=https://kalita-fotografia.com
ADMIN_DOMAIN=https://admin.kalita-fotografia.com

# Configurações do Banco de Dados
DATABASE_URL="postgresql://username:password@localhost:5432/kalita_db?schema=public"

# Configurações de Upload (opcional)
UPLOAD_PROVIDER=local
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=kalita-uploads

# Configurações de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100